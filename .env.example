# Browser (Svelte): gunakan endpoint WebSocket aman dari halaman Overview HiveMQ Cloud.
VITE_MQTT_URL=wss://YOUR_CLUSTER_URL:8884/mqtt
# Catatan: variabel VITE_ terlihat oleh browser. Buat credential khusus dashboard
# dengan izin subscribe terbatas hanya untuk topic di bawah.
VITE_MQTT_USERNAME=dashboard-reader
VITE_MQTT_PASSWORD=ganti-dengan-password-dashboard
VITE_MQTT_TOPIC=sic/waste/sensors

# Publisher Python: gunakan hostname tanpa skema/protokol dan TLS MQTT port 8883.
# Jangan beri credential ini izin subscribe; cukup publish ke topik aplikasi.
MQTT_HOST=YOUR_CLUSTER_URL
MQTT_PORT=8883
MQTT_USERNAME=sensor-publisher
MQTT_PASSWORD=ganti-dengan-password-sensor
MQTT_TOPIC=sic/waste/sensors
